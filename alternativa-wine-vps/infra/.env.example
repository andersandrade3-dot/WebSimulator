# Copie para infra/.env no servidor (NUNCA versionar o .env real).
# Gere segredos:  openssl rand -hex 16   (GUAC_JSON_SECRET, 32 hex = 128 bits)
#                 openssl rand -hex 32   (ORCH_API_TOKEN)

GUAC_HOST=sim.exemplo.com.br              # DNS A -> IP da VPS
ORCH_HOST=api-sim.exemplo.com.br          # DNS A -> IP da VPS
PORTAL_ORIGIN=https://portal.exemplo.com.br   # domínio do portal na Vercel (origem permitida p/ iframe)

GUAC_JSON_SECRET=
ORCH_API_TOKEN=

# Caminho ABSOLUTO, no servidor, da pasta original (contém Simulador.exe, Images/, XML/)
SIM_HOST_PATH=/srv/simulador

SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=                 # somente aqui (servidor) e na Vercel (server-side)

MAX_SESSIONS=10
IDLE_MINUTES=10
SESSION_MEMORY_MB=512
SESSION_CPUS=0.75
SESSION_SCREEN=1280x720
