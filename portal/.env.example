# Variáveis do portal (Vercel > Project > Settings > Environment Variables)
# Modo 100% gratuito: Vercel (Hobby) + Supabase (Free). Nenhuma VPS necessária.

# Públicas (podem ir ao navegador; a anon key é protegida por RLS)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SOMENTE servidor (NÃO usar prefixo NEXT_PUBLIC_). Marque como "Sensitive" na Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: nome do bucket privado no Supabase Storage com os arquivos do simulador
# (padrão: simulator-assets). Usado automaticamente se portal/sim-assets/ não estiver no deploy.
SIM_STORAGE_BUCKET=simulator-assets
